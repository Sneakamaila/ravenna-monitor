# ==========================================
# 🎄 Ravenna-Schlucht Ticket-Monitor Konfiguration
# ==========================================

# Discord Webhook URL für Benachrichtigungen (erforderlich für Discord-Alerts)
# Erstelle einen Webhook in Discord: Server-Einstellungen -> Integrationen -> Webhooks -> Neuer Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/DEINE_WEBHOOK_ID/DEIN_WEBHOOK_TOKEN

# Optionale Erwähnung bei neuen Tickets (z.B. @everyone, @here oder eine Rollen-ID <@&123456789>)
DISCORD_MENTION=

# ==========================================
# 👥 Paar- & Ticketfilter
# ==========================================
# Mindestanzahl an verfügbaren Tickets im selben Timeslot (Ideal für Paare: 2)
MIN_TICKETS=1

# Nur Tickets für Erwachsene melden? (true / false, Standard: false -> meldet alle Kategorien)
ONLY_ADULTS=false

# Maximaler Preis pro Ticket in Euro (optional, z. B. 25.00)
MAX_PRICE_EUR=

# ==========================================
# 📅 Zeit- & Datumsfilter
# ==========================================
# Datumsbereich: Frühestes und spätestes Datum im Format YYYY-MM-DD (z. B. 2026-11-27 bis 2026-12-15)
DATE_FROM=
DATE_TO=

# Erlaubte Wochentage (0=Montag, 1=Dienstag, ..., 4=Freitag, 5=Samstag, 6=Sonntag)
# Standard: 0,1,2,3,4,5,6 (alle Tage) | Nur Wochenende: 4,5,6 | Nur Sa & So: 5,6
ALLOWED_WEEKDAYS=0,1,2,3,4,5,6

# Früheste & späteste Einlasszeit im Format HH:MM (z. B. EARLIEST_TIME=14:00, LATEST_TIME=20:00)
EARLIEST_TIME=
LATEST_TIME=

# Bestimmte Tage ausschließen (YYYY-MM-DD kommasepariert, z. B. 2026-11-26,2026-12-05)
EXCLUDED_DATES=

# ==========================================
# 🚌 Überwachte Anreise-Kategorien
# ==========================================
# 545832 = Shuttle Titisee
# 545884 = Shuttle Hinterzarten
# 545886 = Shuttle Himmelreich
# 546305 = Shuttle Freiburg
# 545934 = PKW Parken & Eintritt
# 545947 = Nur Eintritt (Wander-Ticket)
MONITORED_GROUPS=545832,545884,545886,546305,545934,545947

# ==========================================
# 🌐 Web-UI & Server
# ==========================================
WEB_PORT=8080
WEB_HOST=0.0.0.0
MONITOR_PAUSED=false

# ==========================================
# ⏱️ Taktung & Internes
# ==========================================
# Prüfintervall in Sekunden zwischen den Abfrage-Zyklen (Standard: 30)
CHECK_INTERVAL_SECONDS=30

# Zufälliger Jitter in Sekunden (+/- um Traffic natürlicher wirken zu lassen)
CHECK_INTERVAL_JITTER=5

# Pfad zur Datei, in der bereits gesehene Angebote gespeichert werden (verhindert Spam)
STATE_FILE_PATH=seen_offers.json

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
