# Discord Webhook URL für Benachrichtigungen (erforderlich für Discord-Alerts)
# Erstelle einen Webhook in Discord: Server-Einstellungen -> Integrationen -> Webhooks -> Neuer Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/DEINE_WEBHOOK_ID/DEIN_WEBHOOK_TOKEN

# Optionale Erwähnung bei neuen Tickets (z.B. @everyone, @here oder eine Rollen-ID <@&123456789>)
DISCORD_MENTION=

# Prüfintervall in Sekunden zwischen den Abfrage-Zyklen (Standard: 30)
CHECK_INTERVAL_SECONDS=30

# Zufälliger Jitter in Sekunden (+/- um Traffic natürlicher wirken zu lassen)
CHECK_INTERVAL_JITTER=5

# Filter: Mindestanzahl an verfügbaren Tickets im selben Timeslot (Standard: 1)
MIN_TICKETS=1

# Filter: Nur Tickets für Erwachsene melden? (true / false, Standard: false -> meldet alle Kategorien)
ONLY_ADULTS=false

# Zu überwachende Gruppen-IDs (Kommasepariert, standardmäßig alle 6 Nicht-Bus-Kategorien)
# 545832 = Shuttle Titisee
# 545884 = Shuttle Hinterzarten
# 545886 = Shuttle Himmelreich
# 546305 = Shuttle Freiburg
# 545934 = PKW Parken & Eintritt
# 545947 = Nur Eintritt (Wander-Ticket)
MONITORED_GROUPS=545832,545884,545886,546305,545934,545947

# Pfad zur Datei, in der bereits gesehene Angebote gespeichert werden (verhindert Spam)
STATE_FILE_PATH=seen_offers.json

# Loglevel (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
